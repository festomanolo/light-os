###############################################################################
# Light OS Default OpenVPN Client Configuration (/etc/openvpn/default.ovpn)
# Based on OpenVPN (https://github.com/openvpn/openvpn)
#
# Light OS enforces a pre-Wi-Fi firewall kill switch (lightos-vpn-killswitch)
# BEFORE NetworkManager brings up Wi-Fi. Outbound internet traffic is blocked
# except to the `remote` OpenVPN server(s) declared below and traffic flowing
# through the encrypted `tun+` tunnel interface.
#
# Replace `remote vpn.example.com 1194 udp` or import your `.ovpn` profile with:
#   lightos-vpn-killswitch import /path/to/profile.ovpn
# or via the "Light OS VPN & Kill Switch" desktop app.
###############################################################################

client
dev tun
proto udp

# OpenVPN gateway endpoint(s) — automatically whitelisted by lightos-vpn-killswitch
remote vpn.example.com 1194

resolv-retry infinite
nobind
persist-key
persist-tun

remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3
