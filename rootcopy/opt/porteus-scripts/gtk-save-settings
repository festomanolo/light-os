            # ~ if name == "sndc":
                # ~ print("removing soundcard settings")

    def on_ok_clicked(self, button):
        ## Does /tmp/psc exist?
        check1 = self.dir_exists('/tmp/psc')
        if check1 is False:
            print('nothing to do')
            os.system('/usr/share/porteus/gtkdialog.py -p "There are no settings to save" -s "Choose some or click Cancel." -d err')
        else:
            ## if so, is it empty?
            check2 = os.listdir('/tmp/psc')
            if check2 == []:
                os.system('/usr/share/porteus/gtkdialog.py -p "There are no settings to save" -s "Choose some or click Cancel." -d err')
                print('nothing to do')
            else:
                ## /tmp/psc/ exists and is not empty, so there should be some settings to save..
                print("make the module")
                bootdev = os.getenv('BOOTDEV')
                moddir = bootdev + "/porteus/modules"
                ## Chance to back out
                ask_ok = subprocess.run('/usr/share/porteus/gtkdialog.py -p "Warning! This could overwrite any existing saved settings module!" -s "Do you want to continue?" -d yesno', shell=True).returncode
                print(ask_ok)
                if int(ask_ok) == 0:
                    os.system('dir2xzm /tmp/psc /tmp/psc-settings.xzm')
                    if self.moddir_is_writable() is True:
                        shutil.copy2('/tmp/psc-settings.xzm', moddir)
                        os.system('/usr/share/porteus/gtkdialog.py -p "Your psc-settings.xzm has been saved" -s "to your modules folder." -d info')
                        os.remove('/tmp/psc-settings.xzm')
                        shutil.rmtree('/tmp/psc')
                        Gtk.main_quit()
                    else:
                        os.system('/usr/share/porteus/gtkdialog.py -p "Your modules directory is unavailable," -s "so your psc-settings.xzm is in /tmp" -d err')
                        shutil.rmtree('/tmp/psc')
                        Gtk.main_quit()
                else:
                    os.system('/usr/share/porteus/gtkdialog.py -p "Cleaning up and," -s "exiting" -d info')
                    shutil.rmtree('/tmp/psc')
                    Gtk.main_quit()

    def check_empty(self):
        check1 = os.listdir('/tmp/psc/etc/rc.d')
        if check1 == []:
            print("removing rc.d")
            shutil.rmtree('/tmp/psc/etc/rc.d')
            check2 = os.listdir('/tmp/psc/etc')
            if check2 == []:
                print("removing etc")
                shutil.rmtree('/tmp/psc/etc')
        else:
            print("wtf")

    def check_empty2(self):
        check = os.listdir('/tmp/psc/etc')
        if check == []:
            shutil.rmtree('/tmp/psc/etc')

    def check_empty_gen(self, dirct):
        check = os.listdir(dirct)
        if check == []:
            shutil.rmtree(dirct)

    def dir_exists(self, dirct):
        path1 = os.path.exists(dirct)
        if path1 is True:
            return True
        else:
            return False

    def moddir_is_writable(self):
        bootdev = os.getenv('BOOTDEV')
        portcfg = bootdev + "/boot/syslinux/porteus.cfg"
        bwritable = os.access(portcfg, os.W_OK)
        if bwritable is True:
            return True
        else:
            return False

    def on_cancel_clicked(self, button):
        psc_exists = os.path.isdir('/tmp/psc')
        if psc_exists is True:
            print('cleaning up')
            shutil.rmtree('/tmp/psc')
        print('nothing to do')
        Gtk.main_quit()

win = GtkSaveSet()
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
