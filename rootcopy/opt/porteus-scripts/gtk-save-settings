            # ~ if name == "keym":
                # ~ print("saving keymap settings")
                ## or maybe not?
                #os.system('[ !-e "/tmp/psc/etc/X11/xorg.conf.d/10-keyboard.conf" ] ?
            # ~ if name == "sndc":
                # ~ print("saving soundcard settings")
                ## or maybe not?
                # ~ os.system('[ !-e "/tmp/psc/etc/
        ## what if i change  my mind?
        if state == "off":
            if name == "firew":
                print("removing firewall settings")
                firew_exists = os.path.isfile('/tmp/psc/etc/rc.d/rc.FireWall')
                if firew_exists is True:
                    os.remove('/tmp/psc/etc/rc.d/rc.FireWall')
                    self.check_empty()

                # ~ os.system('[ -e "/tmp/psc/etc/rc.d/rc.FireWall" ] && rm /tmp/psc/etc/rc.d/rc.FireWall')
            if name == "passw":
                print("removing password settings")
                passw_exists = os.path.isfile('/tmp/psc/etc/shadow')
                if passw_exists is True:
                    os.remove('/tmp/psc/etc/shadow')
                    self.check_empty2()
                # ~ os.system('[ -e"/tmp/psc/etc/shadow" ] && rm /etc/shadow')
            if name == "time":
                print("removing time settings")
                timefiles = ['localtime', 'localtime-copied-from', 'hardwareclock']
                for a in timefiles:
                    time_exists = os.path.isfile('/tmp/psc/etc/' + a)
                    if time_exists is True:
                        os.remove('/tmp/psc/etc/' + a)
                        self.check_empty2()
                # ~ os.system('[ -e "/tmp/psc/etc/{localtime,localtime-copied-from,hardwareclock}" ] && rm/tmp/psc/etc/{localtime,localtime-copied-from,hardwareclock}')
            if name == "bluet":
                print("removing bluetooth settings")
                bluet_exists = os.path.isfile('/tmp/psc/etc/rc.d/rc.bluetooth')
                if bluet_exists is True:
                    os.remove('/tmp/psc/etc/rc.d/rc.bluetooth')
                    self.check_empty()
                # ~ os.system('[ -e "/tmp/psc/etc/rc.d/rc.bluetooth" ] && rm /tmp/psc/etc/rc.d/rc.bluetooth')
