                # ~ os.system('[ !-e "/tmp/psc/etc/rc.d/rc.FireWall" ] && cp -a --parents /etc/rc.d/rc.FireWall /tmp/psc/')
                os.makedirs('/tmp/psc/etc/rc.d', exist_ok=True)
                shutil.copy2('/etc/rc.d/rc.FireWall', '/tmp/psc/etc/rc.d')
