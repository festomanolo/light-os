#!/usr/bin/env python3
"""
Light OS OpenVPN & Pre-Wi-Fi Kill Switch Manager (GTK 3)
"""

import json
import os
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Pango


KILLSWITCH_BIN = "/usr/local/bin/lightos-vpn-killswitch"
LOG_FILE = "/var/log/lightos-openvpn.log"


def run_privileged(args):
    cmd = [KILLSWITCH_BIN] + list(args)
    if os.geteuid() != 0:
        if os.path.exists("/usr/bin/pkexec"):
            cmd = ["/usr/bin/pkexec"] + cmd
        elif os.path.exists("/opt/porteus-scripts/xorg/psu"):
            cmd = ["/opt/porteus-scripts/xorg/psu", " ".join(cmd)]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def query_status():
    try:
        proc = subprocess.run(
            [KILLSWITCH_BIN, "json"],
            capture_output=True,
            text=True,
            timeout=4,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            return json.loads(proc.stdout.strip())
    except Exception:
        pass
    return {
        "killswitch": "unknown",
        "openvpn": "stopped",
        "tun_dev": "",
        "tun_ip": "",
        "phys_dev": "",
        "profile": "/etc/openvpn/default.ovpn",
        "remotes_whitelisted": 0,
    }


class LightOSVpnWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Light OS VPN & Kill Switch")
        self.set_default_size(640, 460)
        self.set_border_width(16)
        self.set_position(Gtk.WindowPosition.CENTER)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(root)

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title = Gtk.Label()
        title.set_markup("<span size='x-large' weight='bold'>Light OS OpenVPN &amp; Pre-Wi-Fi Kill Switch</span>")
        title.set_xalign(0)
        subtitle = Gtk.Label(
            label="Default network lockdown layer: blocks all non-VPN internet traffic before Wi-Fi connects."
        )
        subtitle.set_xalign(0)
        header.pack_start(title, False, False, 0)
        header.pack_start(subtitle, False, False, 0)
        root.pack_start(header, False, False, 0)

        # Status frame
        status_frame = Gtk.Frame(label=" Protection Status ")
        status_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        status_box.set_border_width(10)
        status_frame.add(status_box)

        self.banner_label = Gtk.Label()
        self.banner_label.set_xalign(0)
        status_box.pack_start(self.banner_label, False, False, 0)

        grid = Gtk.Grid(column_spacing=16, row_spacing=6)
        self.lbl_ks = Gtk.Label(xalign=0)
        self.lbl_ovpn = Gtk.Label(xalign=0)
        self.lbl_tun = Gtk.Label(xalign=0)
        self.lbl_phys = Gtk.Label(xalign=0)
        self.lbl_prof = Gtk.Label(xalign=0)

        rows = [
            ("Kill Switch:", self.lbl_ks),
            ("OpenVPN Daemon:", self.lbl_ovpn),
            ("VPN Tunnel:", self.lbl_tun),
            ("Wi-Fi / Link:", self.lbl_phys),
            ("Active Profile:", self.lbl_prof),
        ]
        for idx, (name, widget) in enumerate(rows):
            k = Gtk.Label(label=name, xalign=0)
            k.set_markup(f"<b>{name}</b>")
            grid.attach(k, 0, idx, 1, 1)
            grid.attach(widget, 1, idx, 1, 1)

        status_box.pack_start(grid, False, False, 0)
        root.pack_start(status_frame, False, False, 0)

        # Controls
        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.btn_connect = Gtk.Button(label="Connect VPN")
        self.btn_connect.connect("clicked", self.on_connect)
        self.btn_disconnect = Gtk.Button(label="Disconnect VPN")
        self.btn_disconnect.connect("clicked", self.on_disconnect)
        self.btn_import = Gtk.Button(label="Import .ovpn Profile...")
        self.btn_import.connect("clicked", self.on_import)
        self.btn_toggle_ks = Gtk.Button(label="Toggle Kill Switch")
        self.btn_toggle_ks.connect("clicked", self.on_toggle_ks)

        btn_row.pack_start(self.btn_connect, True, True, 0)
        btn_row.pack_start(self.btn_disconnect, True, True, 0)
        btn_row.pack_start(self.btn_import, True, True, 0)
        btn_row.pack_start(self.btn_toggle_ks, True, True, 0)
        root.pack_start(btn_row, False, False, 0)

        # Log output
        log_frame = Gtk.Frame(label=" OpenVPN & Kill Switch Log ")
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_monospace(True)
        scroller.add(self.log_view)
        log_frame.add(scroller)
        root.pack_start(log_frame, True, True, 0)

        self.refresh_status()
        GLib.timeout_add_seconds(3, self.refresh_status)

    def append_log(self, text):
        buf = self.log_view.get_buffer()
        buf.set_text(text)

    def refresh_status(self):
        st = query_status()
        ks = st.get("killswitch", "unknown")
        ovpn = st.get("openvpn", "stopped")
        tun_dev = st.get("tun_dev") or "none"
        tun_ip = st.get("tun_ip") or ""
        phys_dev = st.get("phys_dev") or "disconnected"
        prof = st.get("profile") or "/etc/openvpn/default.ovpn"
        rem = st.get("remotes_whitelisted", 0)

        if ks == "armed" and tun_dev != "none":
            self.banner_label.set_markup(
                "<span foreground='#1b7f37' weight='bold'>PROTECTED — VPN Tunnel Active &amp; Pre-Wi-Fi Kill Switch Armed</span>"
            )
            self.btn_toggle_ks.set_label("Disable Kill Switch")
        elif ks == "armed":
            self.banner_label.set_markup(
                "<span foreground='#b35900' weight='bold'>LOCKED DOWN — Pre-Wi-Fi Kill Switch Armed (Non-VPN Internet Blocked)</span>"
            )
            self.btn_toggle_ks.set_label("Disable Kill Switch")
        else:
            self.banner_label.set_markup(
                "<span foreground='#b30000' weight='bold'>UNPROTECTED — Kill Switch Disabled (Direct Internet Allowed)</span>"
            )
            self.btn_toggle_ks.set_label("Enable Kill Switch")

        self.lbl_ks.set_text(f"{ks.upper()} ({rem} whitelisted remote rule(s))")
        self.lbl_ovpn.set_text(ovpn)
        self.lbl_tun.set_text(f"{tun_dev} {f'({tun_ip})' if tun_ip else ''}".strip())
        self.lbl_phys.set_text(phys_dev)
        self.lbl_prof.set_text(prof)

        if os.path.exists(LOG_FILE):
            try:
                with open(LOG_FILE, "r", encoding="utf-8", errors="replace") as f:
                    lines = f.readlines()[-60:]
                self.append_log("".join(lines))
            except Exception:
                pass
        return True

    def on_connect(self, _btn):
        _, out = run_privileged(["connect"])
        if out.strip():
            self.append_log(out)
        self.refresh_status()

    def on_disconnect(self, _btn):
        _, out = run_privileged(["disconnect"])
        if out.strip():
            self.append_log(out)
        self.refresh_status()

    def on_toggle_ks(self, _btn):
        st = query_status()
        action = "disable" if st.get("killswitch") == "armed" else "enable"
        _, out = run_privileged([action])
        if out.strip():
            self.append_log(out)
        self.refresh_status()

    def on_import(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Select OpenVPN Profile (.ovpn / .conf)",
            parent=self,
            action=Gtk.FileChooserAction.OPEN,
        )
        dlg.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN,
            Gtk.ResponseType.OK,
        )
        flt = Gtk.FileFilter()
        flt.set_name("OpenVPN Profiles (*.ovpn, *.conf)")
        flt.add_pattern("*.ovpn")
        flt.add_pattern("*.conf")
        dlg.add_filter(flt)
        if dlg.run() == Gtk.ResponseType.OK:
            path = dlg.get_filename()
            dlg.destroy()
            if path:
                _, out = run_privileged(["import", path])
                if out.strip():
                    self.append_log(out)
                self.refresh_status()
        else:
            dlg.destroy()


def main():
    win = LightOSVpnWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
